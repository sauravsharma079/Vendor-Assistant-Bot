# --- SAP S/4HANA connection ---
# Required unless SAP_MODE=mock (see below). Until these are set, every
# query correctly reports that SAP isn't connected yet. See
# docs/SANDBOX_SETUP.md for how to get these values from a Communication
# Arrangement in your S/4HANA Cloud trial tenant.
SAP_S4_BASE_URL=
SAP_S4_TOKEN_URL=
SAP_S4_CLIENT_ID=
SAP_S4_CLIENT_SECRET=

# --- Local dev only: mock SAP instead of a real tenant ---
# Set SAP_MODE=mock to route every SAP call to the standalone
# mock-sap-server (mock-sap-server/ at the repo root — run `npm start`
# there first, or host it separately and point MOCK_SAP_BASE_URL at it)
# instead of live S/4HANA. Hard-blocked when NODE_ENV=production — which
# includes any normal hosted deployment — unless ALLOW_MOCK_IN_PRODUCTION
# is ALSO set to "true". Leave both unset for the real connector (the
# default, and what a real client deployment should always use).
# SAP_MODE=mock
# MOCK_SAP_BASE_URL=http://localhost:4001
# ALLOW_MOCK_IN_PRODUCTION=true

# --- SAP OData service paths (optional overrides) ---
# Only set these if your tenant exposes a scenario under a different
# service/entity name than the defaults below. SAP_S4_VENDOR_SERVICE_PATH,
# SAP_S4_INVOICE_SERVICE_PATH, and SAP_S4_PO_ITEM_SERVICE_PATH use standard
# SAP-released services and rarely need changing. SAP_S4_PAYMENT_SERVICE_PATH
# and SAP_S4_FORM16_SERVICE_PATH point at custom CDS view names that are a
# best-effort guess until confirmed against the tenant — run
# `npm run verify:sap` to check all five before a demo, and set these if
# it reports a mismatch.
# SAP_S4_VENDOR_SERVICE_PATH=/sap/opu/odata/sap/API_BUSINESS_PARTNER/A_Supplier
# SAP_S4_INVOICE_SERVICE_PATH=/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV/A_SupplierInvoice
# SAP_S4_PAYMENT_SERVICE_PATH=/sap/opu/odata/sap/ZCDS_VENDOR_LINE_ITEMS/A_VendorLineItem
# SAP_S4_FORM16_SERVICE_PATH=/sap/opu/odata/sap/ZCDS_WHT_CERTIFICATES/A_WithholdingTaxCert
# SAP_S4_PO_ITEM_SERVICE_PATH=/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV/A_PurchaseOrderItem

# --- Sessions ---
# Signs the vendor session cookie issued after OTP verification.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- OTP email delivery ---
# "console" logs the OTP to the server console only (local dev only,
# refuses to run when NODE_ENV=production). "smtp" sends a real email
# via the SMTP_* settings below — required for any real/hosted use.
EMAIL_MODE=console

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vendor Query Assistant <no-reply@yourdomain.com>"

# --- App URL (used to build links in emails) ---
# The agent-assignment notification email links to the Business Support
# dashboard so agents can click straight through. Defaults to localhost
# for local dev — set this to your real hosted URL in production.
# APP_BASE_URL=https://vendor-assistant-bot.veltriance.com

# --- AI free-text chat (optional) ---
# Lets vendors type a question in their own words instead of using the
# menu buttons. Free tier — get a key at console.groq.com, no credit card
# required. The LLM only classifies intent and rewords an already-fetched
# SAP answer; it never generates facts itself (see lib/llm/vendor-assistant.ts).
# Leave unset and the menu-driven flow still works exactly as before —
# the free-text box just replies that AI chat isn't set up yet.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- Business support access ---
# Shared password gating /admin and its APIs (tickets, query log, audit
# log). Required — without it, business support cannot sign in at all.
# Generate something you wouldn't mind rotating, e.g.: openssl rand -hex 12
ADMIN_PASSWORD=

# --- Persistence (required on serverless hosting, e.g. Vercel) ---
# OTP challenges, admin lockout, and the ticket/query-log/audit store all
# need a real shared store once this runs as serverless functions — a
# file one request writes to local disk isn't visible to the next request,
# which may land on a different instance. Add a Redis integration from the
# Vercel Marketplace (or any Upstash Redis database) and it auto-injects
# one of these two pairs; either works. Leave both unset for local dev —
# falls back to a local .data/*.json file automatically, no setup needed.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
